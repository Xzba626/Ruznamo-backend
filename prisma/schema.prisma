generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum UserCategory {
  TEACHER
  LECTURER
  TUTOR
  TRAINER
  EMPLOYEE
  STUDENT
  PERSONAL
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  DELETED
}

enum Platform {
  ANDROID
}

enum LicenseStatus {
  PENDING
  ACTIVE
  EXPIRED
  REVOKED
  SUSPENDED
}

enum LicenseIssueSource {
  TELEGRAM_PAYMENT
  ADMIN_MANUAL
  UNKNOWN_LEGACY
}

enum PlanCode {
  STANDARD
  PRO
  PRO_PLUS
}

enum BillingPeriod {
  MONTHLY
  YEARLY
}

enum OrderStatus {
  PENDING
  RECEIPT_SUBMITTED
  UNDER_REVIEW
  APPROVED
  REJECTED
  CANCELLED
  COMPLETED
}

enum ReceiptStatus {
  PENDING
  APPROVED
  REJECTED
}

enum FeatureValueType {
  INT
  BOOL
  STRING
}

enum AuditActorType {
  USER
  ADMIN
  SYSTEM
  TELEGRAM_BOT
}

enum AdminRoleCode {
  SUPER_ADMIN
  ADMIN
  SUPPORT
}

enum TrialGrantStatus {
  ACTIVE
  EXPIRED
  REVOKED
}

enum OutboxStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

enum TelegramLanguage {
  TJ
  RU
}

enum PaymentMethodType {
  PHONE
  CARD
}

enum TelegramAuthPurpose {
  LOGIN
  RECOVERY
  DEVICE_REPLACEMENT
  KEY_REVEAL
  LINK_ACCOUNT
}

enum SupportConversationStatus {
  OPEN
  CLOSED
}

enum SupportMessageDirection {
  USER_TO_ADMIN
  ADMIN_TO_USER
}

enum SupportMessageContentType {
  TEXT
  PHOTO
  DOCUMENT
}

enum SystemSecurityCredentialType {
  DATA_RESET
}

enum AppReleaseStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
  PURGED
}

enum DataResetScope {
  TEST_DATA_CLEANUP
  USER_DATA_RESET
  FACTORY_RESET
}

enum AdminTelegramIdentityStatus {
  ACTIVE
  REVOKED
}

enum LicenseActivationRevokeReason {
  HOLDER_DISCONNECT
  ADMIN_DISCONNECT
  DEVICE_REPLACEMENT
}

// ---------------------------------------------------------------------------
// Users & identity
// ---------------------------------------------------------------------------

model User {
  id          String       @id @default(cuid())
  displayName String?
  category    UserCategory @default(PERSONAL)
  status      UserStatus   @default(ACTIVE)
  email       String?      @unique
  phone       String?
  createdAt   DateTime     @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime     @updatedAt @db.Timestamptz(3)

  telegramAccount           TelegramAccount?
  telegramLinkTokens        TelegramLinkToken[]
  telegramLicenseLinkChallenges TelegramLicenseLinkChallenge[]
  deviceReplacementChallenges   DeviceReplacementChallenge[]
  telegramAuthChallenges        TelegramAuthChallenge[]
  telegramRecoveryGrants        TelegramRecoveryGrant[]
  devices                   DeviceInstallation[]
  licenses           License[]
  orders             Order[]
  trialGrant         TrialGrant?
  refreshTokens      RefreshToken[]

  @@index([status])
  @@index([createdAt])
}

model TelegramAccount {
  id         String            @id @default(cuid())
  userId     String            @unique
  telegramId BigInt            @unique
  chatId     BigInt?
  username   String?
  firstName  String?
  lastName   String?
  language   TelegramLanguage?
  linkedAt   DateTime          @default(now()) @db.Timestamptz(3)
  createdAt  DateTime @default(now()) @db.Timestamptz(3)
  updatedAt  DateTime @updatedAt @db.Timestamptz(3)

  user               User                         @relation(fields: [userId], references: [id], onDelete: Cascade)
  purchasedLicenses  License[]                    @relation("LicensePurchaserTelegram")
  heldLicenses       License[]                    @relation("LicenseHolderTelegram")
  holderHistoryFrom  LicenseHolderHistory[]       @relation("HolderHistoryFrom")
  holderHistoryTo    LicenseHolderHistory[]       @relation("HolderHistoryTo")
  authChallenges     TelegramAuthChallenge[]
  recoveryGrants     TelegramRecoveryGrant[]
  supportConversations SupportConversation[]

  @@index([telegramId])
}

model TelegramLinkToken {
  id        String    @id @default(cuid())
  userId    String
  code      String    @unique
  expiresAt DateTime  @db.Timestamptz(3)
  usedAt    DateTime? @db.Timestamptz(3)
  createdAt DateTime  @default(now()) @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model DeviceInstallation {
  id                 String    @id @default(cuid())
  userId             String
  installationId     String    @unique
  deviceName         String?
  deviceManufacturer String?
  deviceModel        String?
  androidOsVersion   String?
  platform           Platform  @default(ANDROID)
  appVersion         String?
  appVersionName     String?
  appVersionCode     Int?
  appLocale          String?
  registrationIp     String?
  lastSeenIp         String?
  lastSeenAt         DateTime  @default(now()) @db.Timestamptz(3)
  revokedAt          DateTime? @db.Timestamptz(3)
  createdAt          DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt          DateTime  @updatedAt @db.Timestamptz(3)

  user          User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  activations   LicenseActivation[]
  refreshTokens RefreshToken[]
  telegramLinkChallenges     TelegramLicenseLinkChallenge[]
  replacementChallengesNew   DeviceReplacementChallenge[] @relation("ReplacementNewDevice")
  replacementChallengesOld   DeviceReplacementChallenge[] @relation("ReplacementOldDevice")
  telegramAuthChallenges     TelegramAuthChallenge[]
  telegramRecoveryGrants     TelegramRecoveryGrant[]

  @@index([userId])
  @@index([userId, revokedAt])
}

model TrialGrant {
  id             String           @id @default(cuid())
  userId         String           @unique
  installationId String           @unique
  status         TrialGrantStatus @default(ACTIVE)
  startedAt      DateTime         @default(now()) @db.Timestamptz(3)
  expiresAt      DateTime         @db.Timestamptz(3)
  endedAt        DateTime?        @db.Timestamptz(3)
  metadata       Json?
  createdAt      DateTime         @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime         @updatedAt @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([status])
  @@index([expiresAt])
  @@index([installationId])
}

// ---------------------------------------------------------------------------
// Plans & entitlements
// ---------------------------------------------------------------------------

model Plan {
  id        String   @id @default(cuid())
  code      PlanCode @unique
  name      String
  nameTj    String?
  isActive  Boolean  @default(true)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  prices   PlanPrice[]
  features PlanFeature[]
  licenses License[]
  orders   Order[]
}

model PlanPrice {
  id            String        @id @default(cuid())
  planId        String
  billingPeriod BillingPeriod
  amount        Decimal       @db.Decimal(10, 2)
  currency      String        @default("TJS")
  isActive      Boolean       @default(true)
  createdAt     DateTime      @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime      @updatedAt @db.Timestamptz(3)

  plan Plan @relation(fields: [planId], references: [id], onDelete: Restrict)

  @@unique([planId, billingPeriod])
}

model PlanFeature {
  id        String           @id @default(cuid())
  planId    String
  key       String
  value     String
  valueType FeatureValueType
  createdAt DateTime         @default(now()) @db.Timestamptz(3)
  updatedAt DateTime         @updatedAt @db.Timestamptz(3)

  plan Plan @relation(fields: [planId], references: [id], onDelete: Cascade)

  @@unique([planId, key])
}

// ---------------------------------------------------------------------------
// Licenses
// ---------------------------------------------------------------------------

model License {
  id                         String              @id @default(cuid())
  planId                     String
  userId                     String?
  orderId                    String?             @unique
  keyHash                    String              @unique
  keyPrefix                  String
  status                     LicenseStatus       @default(PENDING)
  issueSource                LicenseIssueSource?
  issuedByAdminId            String?
  adminNote                  String?
  customerLabel              String?
  purchaserTelegramAccountId String?
  holderTelegramAccountId    String?
  holderLinkedAt             DateTime?           @db.Timestamptz(3)
  startsAt                   DateTime?           @db.Timestamptz(3)
  expiresAt                  DateTime?           @db.Timestamptz(3)
  activatedAt                DateTime?           @db.Timestamptz(3)
  revokedAt                  DateTime?           @db.Timestamptz(3)
  createdAt                  DateTime            @default(now()) @db.Timestamptz(3)
  updatedAt                  DateTime            @updatedAt @db.Timestamptz(3)

  plan                     Plan                       @relation(fields: [planId], references: [id], onDelete: Restrict)
  user                     User?                      @relation(fields: [userId], references: [id], onDelete: SetNull)
  order                    Order?                     @relation(fields: [orderId], references: [id], onDelete: SetNull)
  issuedByAdmin            AdminUser?                 @relation("LicenseIssuedByAdmin", fields: [issuedByAdminId], references: [id], onDelete: SetNull)
  purchaserTelegramAccount TelegramAccount?           @relation("LicensePurchaserTelegram", fields: [purchaserTelegramAccountId], references: [id], onDelete: SetNull)
  holderTelegramAccount    TelegramAccount?           @relation("LicenseHolderTelegram", fields: [holderTelegramAccountId], references: [id], onDelete: SetNull)
  activations              LicenseActivation[]
  events                   LicenseEvent[]
  holderHistory            LicenseHolderHistory[]
  telegramLinkChallenges   TelegramLicenseLinkChallenge[]
  replacementChallenges    DeviceReplacementChallenge[]

  @@index([userId])
  @@index([purchaserTelegramAccountId])
  @@index([holderTelegramAccountId])
  @@index([status])
  @@index([expiresAt])
  @@index([keyPrefix])
}

model LicenseActivation {
  id           String                          @id @default(cuid())
  licenseId    String
  deviceId     String
  createdAt    DateTime                        @default(now()) @db.Timestamptz(3)
  /// Soft-revoke of THIS license slot on THIS installation (not a global device block).
  revokedAt    DateTime?                       @db.Timestamptz(3)
  revokeReason LicenseActivationRevokeReason?

  license License            @relation(fields: [licenseId], references: [id], onDelete: Cascade)
  device  DeviceInstallation @relation(fields: [deviceId], references: [id], onDelete: Cascade)

  @@unique([licenseId, deviceId])
  @@index([licenseId, revokedAt])
  @@index([deviceId, revokedAt])
}

model LicenseEvent {
  id         String         @id @default(cuid())
  licenseId  String
  fromStatus LicenseStatus?
  toStatus   LicenseStatus
  reason     String?
  metadata   Json?
  createdAt  DateTime       @default(now()) @db.Timestamptz(3)

  license License @relation(fields: [licenseId], references: [id], onDelete: Cascade)

  @@index([licenseId, createdAt])
}

model LicenseHolderHistory {
  id                      String         @id @default(cuid())
  licenseId               String
  fromTelegramAccountId   String?
  toTelegramAccountId     String?
  reason                  String
  actorType               AuditActorType
  actorId                 String?
  createdAt               DateTime       @default(now()) @db.Timestamptz(3)

  license               License          @relation(fields: [licenseId], references: [id], onDelete: Cascade)
  fromTelegramAccount   TelegramAccount? @relation("HolderHistoryFrom", fields: [fromTelegramAccountId], references: [id], onDelete: SetNull)
  toTelegramAccount     TelegramAccount? @relation("HolderHistoryTo", fields: [toTelegramAccountId], references: [id], onDelete: SetNull)

  @@index([licenseId, createdAt])
}

model TelegramLicenseLinkChallenge {
  id           String    @id @default(cuid())
  token        String    @unique
  licenseId    String
  deviceId     String
  mobileUserId String
  expiresAt    DateTime  @db.Timestamptz(3)
  consumedAt   DateTime? @db.Timestamptz(3)
  createdAt    DateTime  @default(now()) @db.Timestamptz(3)

  license License            @relation(fields: [licenseId], references: [id], onDelete: Cascade)
  device  DeviceInstallation @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  user    User               @relation(fields: [mobileUserId], references: [id], onDelete: Cascade)

  @@index([expiresAt])
  @@index([licenseId])
}

model DeviceReplacementChallenge {
  id           String    @id @default(cuid())
  token        String    @unique
  licenseId    String
  newDeviceId  String
  oldDeviceId  String
  mobileUserId String
  expiresAt    DateTime  @db.Timestamptz(3)
  consumedAt   DateTime? @db.Timestamptz(3)
  createdAt    DateTime  @default(now()) @db.Timestamptz(3)

  license   License            @relation(fields: [licenseId], references: [id], onDelete: Cascade)
  newDevice DeviceInstallation @relation("ReplacementNewDevice", fields: [newDeviceId], references: [id], onDelete: Cascade)
  oldDevice DeviceInstallation @relation("ReplacementOldDevice", fields: [oldDeviceId], references: [id], onDelete: Cascade)
  user      User               @relation(fields: [mobileUserId], references: [id], onDelete: Cascade)

  @@index([expiresAt])
  @@index([licenseId])
}

model TelegramAuthChallenge {
  id                    String              @id @default(cuid())
  tokenHash             String              @unique
  requestingDeviceId    String
  requestingMobileUserId String
  purpose               TelegramAuthPurpose
  contextLicenseId      String?
  telegramAccountId     String?
  otpHash               String?
  otpExpiresAt          DateTime?           @db.Timestamptz(3)
  attemptCount          Int                 @default(0)
  maxAttempts           Int                 @default(5)
  verifiedAt            DateTime?           @db.Timestamptz(3)
  consumedAt            DateTime?           @db.Timestamptz(3)
  expiresAt             DateTime            @db.Timestamptz(3)
  createdAt             DateTime            @default(now()) @db.Timestamptz(3)

  requestingDevice DeviceInstallation @relation(fields: [requestingDeviceId], references: [id], onDelete: Cascade)
  requestingUser   User               @relation(fields: [requestingMobileUserId], references: [id], onDelete: Cascade)
  telegramAccount  TelegramAccount?   @relation(fields: [telegramAccountId], references: [id], onDelete: SetNull)
  recoveryGrants   TelegramRecoveryGrant[]

  @@index([expiresAt])
  @@index([requestingDeviceId, createdAt])
  @@index([telegramAccountId])
  @@index([contextLicenseId])
}

model SupportConversation {
  id                String                    @id @default(cuid())
  telegramAccountId String
  status            SupportConversationStatus @default(OPEN)
  category          String?
  createdAt         DateTime                  @default(now()) @db.Timestamptz(3)
  updatedAt         DateTime                  @updatedAt @db.Timestamptz(3)
  closedAt          DateTime?                 @db.Timestamptz(3)

  telegramAccount TelegramAccount  @relation(fields: [telegramAccountId], references: [id], onDelete: Cascade)
  messages        SupportMessage[]

  @@index([telegramAccountId, status])
  @@index([updatedAt])
}

model SupportMessage {
  id                String                    @id @default(cuid())
  conversationId    String
  direction         SupportMessageDirection
  telegramMessageId BigInt?
  contentType       SupportMessageContentType @default(TEXT)
  text              String?
  caption           String?
  fileId            String?
  createdAt         DateTime                  @default(now()) @db.Timestamptz(3)

  conversation SupportConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
}

model TelegramRecoveryGrant {
  id                String    @id @default(cuid())
  challengeId       String
  telegramAccountId String
  deviceId          String
  mobileUserId      String
  expiresAt         DateTime  @db.Timestamptz(3)
  consumedAt        DateTime? @db.Timestamptz(3)
  createdAt         DateTime  @default(now()) @db.Timestamptz(3)

  challenge       TelegramAuthChallenge @relation(fields: [challengeId], references: [id], onDelete: Cascade)
  telegramAccount TelegramAccount       @relation(fields: [telegramAccountId], references: [id], onDelete: Cascade)
  device          DeviceInstallation    @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  user            User                  @relation(fields: [mobileUserId], references: [id], onDelete: Cascade)

  @@index([expiresAt])
  @@index([deviceId, mobileUserId])
  @@index([telegramAccountId])
}

// ---------------------------------------------------------------------------
// Orders & receipts
// ---------------------------------------------------------------------------

model Order {
  id              String        @id @default(cuid())
  userId          String
  planId          String
  billingPeriod   BillingPeriod
  amount          Decimal       @db.Decimal(10, 2)
  currency        String        @default("TJS")
  status          OrderStatus   @default(PENDING)
  awaitingReceipt Boolean       @default(false)
  paidAt          DateTime?     @db.Timestamptz(3)
  approvedAt      DateTime?     @db.Timestamptz(3)
  approvedById    String?
  rejectedAt            DateTime? @db.Timestamptz(3)
  rejectionReason       String?
  rejectionReasonCode   String?
  expiresAt       DateTime?     @db.Timestamptz(3)
  idempotencyKey  String?       @unique
  paymentMethodId        String?
  paymentMethodName      String?
  paymentMethodType      PaymentMethodType?
  paymentMethodValue     String?
  paymentMethodRecipient String?
  createdAt       DateTime      @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime      @updatedAt @db.Timestamptz(3)

  user          User           @relation(fields: [userId], references: [id], onDelete: Restrict)
  plan          Plan           @relation(fields: [planId], references: [id], onDelete: Restrict)
  paymentMethod PaymentMethod? @relation(fields: [paymentMethodId], references: [id], onDelete: SetNull)
  approvedBy AdminUser? @relation("OrderApprovedBy", fields: [approvedById], references: [id], onDelete: SetNull)
  receipts   Receipt[]
  license    License?

  @@index([userId])
  @@index([userId, status])
  @@index([status])
  @@index([createdAt])
}

model PaymentMethod {
  id            String            @id @default(cuid())
  name          String
  type          PaymentMethodType
  paymentValue  String
  recipientName String
  isActive      Boolean           @default(true)
  sortOrder     Int               @default(0)
  createdAt     DateTime          @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime          @updatedAt @db.Timestamptz(3)

  orders Order[]

  @@index([isActive, sortOrder])
}

model TelegramBotSession {
  telegramUserId BigInt   @id
  flow           String
  step           String?
  payload        Json?
  expiresAt      DateTime @db.Timestamptz(3)
  updatedAt      DateTime @updatedAt @db.Timestamptz(3)

  @@index([expiresAt])
}

model Receipt {
  id               String        @id @default(cuid())
  orderId          String
  telegramFileId   String
  fileType         String
  telegramUpdateId BigInt?       @unique
  status           ReceiptStatus @default(PENDING)
  submittedAt      DateTime      @default(now()) @db.Timestamptz(3)
  reviewedAt       DateTime?     @db.Timestamptz(3)
  reviewedById     String?
  rejectionReason  String?
  metadata         Json?

  order      Order      @relation(fields: [orderId], references: [id], onDelete: Cascade)
  reviewedBy AdminUser? @relation("ReceiptReviewedBy", fields: [reviewedById], references: [id], onDelete: SetNull)

  @@index([orderId])
  @@index([status])
}

// ---------------------------------------------------------------------------
// Auth sessions
// ---------------------------------------------------------------------------

model RefreshToken {
  id         String    @id @default(cuid())
  userId     String
  deviceId   String?
  tokenHash  String    @unique
  expiresAt  DateTime  @db.Timestamptz(3)
  revokedAt  DateTime? @db.Timestamptz(3)
  replacedBy String?
  userAgent  String?
  ipAddress  String?
  createdAt  DateTime  @default(now()) @db.Timestamptz(3)

  user   User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  device DeviceInstallation? @relation(fields: [deviceId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([deviceId])
  @@index([expiresAt])
}

// ---------------------------------------------------------------------------
// Admin RBAC
// ---------------------------------------------------------------------------

model AdminUser {
  id           String    @id @default(cuid())
  email        String    @unique
  passwordHash String
  displayName  String?
  telegramId   BigInt?   @unique
  isActive     Boolean   @default(true)
  lastLoginAt  DateTime? @db.Timestamptz(3)
  createdAt    DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime  @updatedAt @db.Timestamptz(3)

  roles                 AdminUserRole[]
  refreshTokens         AdminRefreshToken[]
  telegramIdentity         AdminTelegramIdentity?
  telegramLinkTokens       AdminTelegramLinkToken[]
  telegramRebindChallenges AdminTelegramRebindChallenge[]
  approvedOrders        Order[]                  @relation("OrderApprovedBy")
  reviewedReceipts      Receipt[]                @relation("ReceiptReviewedBy")
  issuedLicenses        License[]                @relation("LicenseIssuedByAdmin")
  appReleases           AppRelease[]

  @@index([isActive])
}

model AdminRefreshToken {
  id          String    @id @default(cuid())
  adminUserId String
  tokenHash   String    @unique
  expiresAt   DateTime  @db.Timestamptz(3)
  revokedAt   DateTime? @db.Timestamptz(3)
  replacedBy  String?
  userAgent   String?
  ipAddress   String?
  createdAt   DateTime  @default(now()) @db.Timestamptz(3)

  adminUser AdminUser @relation(fields: [adminUserId], references: [id], onDelete: Cascade)

  @@index([adminUserId])
  @@index([expiresAt])
}

model AdminTelegramIdentity {
  id             String                      @id @default(cuid())
  adminUserId    String                      @unique
  telegramUserId BigInt                      @unique
  chatId         BigInt?
  username       String?
  firstName      String?
  isVerified     Boolean                     @default(false)
  status         AdminTelegramIdentityStatus @default(ACTIVE)
  verifiedAt     DateTime?                   @db.Timestamptz(3)
  revokedAt      DateTime?                   @db.Timestamptz(3)
  lastSeenAt     DateTime?                   @db.Timestamptz(3)
  createdAt      DateTime                    @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime                    @updatedAt @db.Timestamptz(3)

  adminUser AdminUser @relation(fields: [adminUserId], references: [id], onDelete: Cascade)

  @@index([isVerified])
  @@index([status])
}

model AdminTelegramRevokedId {
  telegramUserId       BigInt   @id
  revokedAt            DateTime @default(now()) @db.Timestamptz(3)
  revokedByAdminUserId String?

  @@index([revokedAt])
}

model AdminTelegramRebindChallenge {
  id             String    @id @default(cuid())
  adminUserId    String
  tokenHash      String    @unique
  otpHash        String?
  telegramUserId BigInt?
  expiresAt      DateTime  @db.Timestamptz(3)
  consumedAt     DateTime? @db.Timestamptz(3)
  createdAt      DateTime  @default(now()) @db.Timestamptz(3)

  adminUser AdminUser @relation(fields: [adminUserId], references: [id], onDelete: Cascade)

  @@index([adminUserId])
  @@index([expiresAt])
}

model AdminTelegramLinkToken {
  id          String    @id @default(cuid())
  adminUserId String
  code        String    @unique
  expiresAt   DateTime  @db.Timestamptz(3)
  usedAt      DateTime? @db.Timestamptz(3)
  createdAt   DateTime  @default(now()) @db.Timestamptz(3)

  adminUser AdminUser @relation(fields: [adminUserId], references: [id], onDelete: Cascade)

  @@index([adminUserId])
  @@index([expiresAt])
}

model Role {
  id          String          @id @default(cuid())
  code        AdminRoleCode   @unique
  name        String
  permissions RolePermission[]
  admins      AdminUserRole[]
}

model Permission {
  id    String @id @default(cuid())
  code  String @unique
  name  String
  roles RolePermission[]
}

model RolePermission {
  roleId       String
  permissionId String
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
}

model AdminUserRole {
  adminUserId String
  roleId      String
  adminUser   AdminUser @relation(fields: [adminUserId], references: [id], onDelete: Cascade)
  role        Role      @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([adminUserId, roleId])
}

// ---------------------------------------------------------------------------
// Audit, config, outbox
// ---------------------------------------------------------------------------

model AuditLog {
  id         String         @id @default(cuid())
  actorType  AuditActorType
  actorId    String?
  action     String
  entityType String
  entityId   String?
  metadata   Json?
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime       @default(now()) @db.Timestamptz(3)

  @@index([action])
  @@index([entityType, entityId])
  @@index([createdAt])
  @@index([actorType, actorId])
}

model AppVersion {
  id                      String   @id @default(cuid())
  platform                Platform @default(ANDROID)
  latestVersion           String
  minimumSupportedVersion String
  updateUrl               String?
  forceUpdate             Boolean  @default(false)
  releaseNotes            String?
  releaseNotesTj          String?
  isActive                Boolean  @default(true)
  createdAt               DateTime @default(now()) @db.Timestamptz(3)
  updatedAt               DateTime @updatedAt @db.Timestamptz(3)

  @@index([platform, isActive])
}

model AppRelease {
  id                       String           @id @default(cuid())
  platform                 Platform         @default(ANDROID)
  versionName              String
  versionCode              Int
  packageName              String
  signingCertificateSha256 String
  objectKey                String
  fileSize                 BigInt
  sha256                   String
  status                   AppReleaseStatus @default(DRAFT)
  mandatory                Boolean          @default(false)
  changelogRu              String?
  changelogTg              String?
  createdByAdminId         String?
  createdAt                DateTime         @default(now()) @db.Timestamptz(3)
  publishedAt              DateTime?        @db.Timestamptz(3)
  archivedAt               DateTime?        @db.Timestamptz(3)

  createdBy AdminUser? @relation(fields: [createdByAdminId], references: [id], onDelete: SetNull)

  @@unique([platform, versionCode])
  @@index([platform, status])
  @@index([publishedAt])
}

model SystemSecurityCredential {
  id                String                       @id @default(cuid())
  type              SystemSecurityCredentialType @unique
  passwordHash      String
  passwordChangedAt DateTime                     @db.Timestamptz(3)
  createdAt         DateTime                     @default(now()) @db.Timestamptz(3)
  updatedAt         DateTime                     @updatedAt @db.Timestamptz(3)
}

model SystemConfig {
  key       String   @id
  value     String
  valueJson Json?
  updatedAt DateTime @updatedAt @db.Timestamptz(3)
}

model IdempotencyRecord {
  id             String   @id @default(cuid())
  key            String   @unique
  requestHash    String
  responseStatus Int
  responseBody   Json
  expiresAt      DateTime @db.Timestamptz(3)
  createdAt      DateTime @default(now()) @db.Timestamptz(3)

  @@index([expiresAt])
}

model NotificationOutbox {
  id          String       @id @default(cuid())
  type        String
  payload     Json
  status      OutboxStatus @default(PENDING)
  attempts    Int          @default(0)
  lastError   String?
  scheduledAt DateTime     @default(now()) @db.Timestamptz(3)
  processedAt DateTime?    @db.Timestamptz(3)
  createdAt   DateTime     @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime     @updatedAt @db.Timestamptz(3)

  @@index([status, scheduledAt])
  @@index([type, status])
}

model TelegramProcessedUpdate {
  updateId  BigInt   @id
  createdAt DateTime @default(now()) @db.Timestamptz(3)
}

/// Maps admin-chat relay messages to originating user for support reply routing.
model SupportRelayMapping {
  id                  String   @id @default(cuid())
  adminChatId         BigInt
  adminMessageId      Int
  userChatId          BigInt
  userTelegramId      BigInt
  sourceUserMessageId Int?
  createdAt           DateTime @default(now()) @db.Timestamptz(3)

  @@unique([adminChatId, adminMessageId])
  @@index([userTelegramId])
  @@index([createdAt])
}
