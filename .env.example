# Application (local dev only — omit on Vercel)
# NODE_ENV=production
# PORT=3000
# Neon PostgreSQL
# DATABASE_URL = pooled connection (runtime / Vercel / app queries)
# DIRECT_URL   = direct connection (Prisma migrations & schema operations)
DATABASE_URL=
DIRECT_URL=

# Public URLs
API_BASE_URL=
APP_BASE_URL=
LOG_LEVEL=

# JWT (min 32 characters each — generate unique secrets per environment)
JWT_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

# License cryptography (min 32 characters — server-only, never in Android)
LICENSE_KEY_PEPPER=

# CORS (comma-separated origins)
CORS_ORIGINS=

# Rate limiting (optional — defaults: 60000 ms / 100 req; omit on Vercel)
# THROTTLE_TTL=60000
# THROTTLE_LIMIT=100
# Telegram (BLOCK 5+)
TELEGRAM_USER_BOT_TOKEN=
TELEGRAM_ADMIN_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
ADMIN_TELEGRAM_CHAT_ID=

# Android update URL fallback (primary source: AppVersion table)
ANDROID_UPDATE_URL=
