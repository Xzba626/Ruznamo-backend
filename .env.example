# Application (local dev only — omit on Vercel)
# NODE_ENV=production
# PORT=3000
# Neon PostgreSQL
# DATABASE_URL = pooled connection (runtime / Vercel / app queries)
# DIRECT_URL   = direct connection (Prisma migrations & schema operations)
DATABASE_URL=
DIRECT_URL=

# Public URLs
API_BASE_URL=
APP_BASE_URL=
LOG_LEVEL=

# JWT (min 32 characters each — generate unique secrets per environment)
JWT_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

# License cryptography (min 32 characters — server-only, never in Android)
LICENSE_KEY_PEPPER=

# CORS (comma-separated origins; admin-panel*.vercel.app previews are allowed automatically)
CORS_ORIGINS=

# Rate limiting (optional — defaults: 60000 ms / 100 req; omit on Vercel)
# THROTTLE_TTL=60000
# THROTTLE_LIMIT=100
# Telegram (BLOCK 5A — single bot)
# Production: set BOTH TELEGRAM_BOT_TOKEN and TELEGRAM_WEBHOOK_SECRET (min 16 chars).
# Generate secret: openssl rand -hex 24
# If only the token is set on Vercel, the API will start but Telegram stays disabled.
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_WEBHOOK_SECRET=
ADMIN_TELEGRAM_IDS=

# Android update URL fallback (primary source: AppVersion table / AppRelease)
ANDROID_UPDATE_URL=

# Production APK storage: Vercel Private Blob (owner-connected store).
# After connecting Blob to the BACKEND Vercel project:
RELEASE_STORAGE_PROVIDER=vercel_blob
# BLOB_READ_WRITE_TOKEN is auto-injected by Vercel when the store is connected.
# Do not put Blob tokens in Admin frontend env.
# BLOB_READ_WRITE_TOKEN=
# BLOB_APK_PREFIX=releases/android

# Legacy S3-compatible (local/dev fallback only; not production authority)
# S3_ENDPOINT=
# S3_BUCKET=
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_REGION=auto
# S3_PUBLIC_BASE_URL=

# Production Android package + release signing identity (SHA-256 of signing cert)
ANDROID_PACKAGE_NAME=com.Tajroot.Ruznamo
# ANDROID_RELEASE_SIGNING_CERT_SHA256=

# Signed release manifest (Ed25519) — SEPARATE from Android APK keystore.
# Do NOT put private key in Git, Admin frontend, or Android.
# Owner generates keypair locally; see docs/OWNER_ACTION_RELEASE_MANIFEST_KEY.md
# ANDROID_RELEASE_MANIFEST_PRIVATE_KEY=
# ANDROID_RELEASE_MANIFEST_KEY_ID=rmk_v1
