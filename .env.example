# Application
NODE_ENV=development
PORT=3000
API_BASE_URL=http://localhost:3000
APP_BASE_URL=http://localhost:3000
LOG_LEVEL=info

# Database
DATABASE_URL=postgresql://ruznamo:ruznamo@localhost:5432/ruznamo?schema=public

# JWT (generate unique secrets for production)
JWT_SECRET=dev-jwt-secret-change-me-min-32-chars!!
JWT_REFRESH_SECRET=dev-refresh-secret-change-me-32-chars!
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

# License cryptography
LICENSE_KEY_PEPPER=dev-license-pepper-change-me-32-chars!

# CORS (comma-separated origins)
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Rate limiting
THROTTLE_TTL=60000
THROTTLE_LIMIT=100

# Telegram (optional until BLOCK 5)
TELEGRAM_USER_BOT_TOKEN=
TELEGRAM_ADMIN_BOT_TOKEN=
ADMIN_TELEGRAM_IDS=
